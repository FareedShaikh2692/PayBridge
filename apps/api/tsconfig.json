{
  "extends": "@paybridge/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noUnusedLocals": false,
    "types": [
      "node",
      "jest"
    ],
    "declaration": false
  },
  "include": [
    "src",
    "test"
  ]
}