# PayBridge on Vercel (serverless). There is no long-lived worker, so the outbox table is the queue
# (QUEUE_DRIVER=inline) and follow-up work runs after each request and from the daily cron.
# API project
NODE_ENV=production
APP_ENV=staging
DATABASE_URL=postgresql://<pooled connection string>?sslmode=require
QUEUE_DRIVER=inline
JWT_SECRET=<openssl rand -base64 32>
DATA_ENCRYPTION_KEY=<openssl rand -base64 32>
FINGERPRINT_HMAC_KEY=<openssl rand -base64 32>
WEBHOOK_SIGNING_SECRET=<openssl rand -base64 32>
WEBHOOK_TARGET_URL=https://<api-project>.vercel.app
CORS_ORIGINS=https://<web-project>.vercel.app
COOKIE_SECURE=true
CRON_SECRET=<openssl rand -base64 32>
MOCK_PROVIDER_DELAY_MS=2000
DATABASE_POOL_MAX=3
# Web project
API_URL=https://<api-project>.vercel.app
