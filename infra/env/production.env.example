# PayBridge — production-style configuration example. Placeholders only; supply real values through your
# platform's secret store, never through a committed file.
NODE_ENV=production
APP_ENV=production
PORT=4000
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/paybridge?sslmode=require
REDIS_URL=rediss://default:<password>@<host>:6379
QUEUE_DRIVER=bullmq
# Run `node dist/worker.js` as a separate process and keep the API stateless.
WORKER_INLINE=false
JWT_SECRET=<openssl rand -base64 32>
DATA_ENCRYPTION_KEY=<openssl rand -base64 32>
FINGERPRINT_HMAC_KEY=<openssl rand -base64 32>
WEBHOOK_SIGNING_SECRET=<openssl rand -base64 32>
WEBHOOK_TARGET_URL=https://api.example.test
CORS_ORIGINS=https://app.example.test
COOKIE_SECURE=true
KYB_AUTO_APPROVE=false
MOCK_PROVIDER_DELAY_MS=3000
LOG_LEVEL=info

# Production-style differences: no seed data (the seed script refuses unless APP_ENV=development or
# ALLOW_SEED=true), Swagger off, quieter logs. There is no real production: PayBridge is a simulation.
SWAGGER_ENABLED=false
