# PayBridge — Educational Sandbox — No Real Money Movement.
# Copy to .env. Every value here is a development placeholder; generate your own secrets with:
#   openssl rand -base64 32

NODE_ENV=development
APP_ENV=development
PORT=4000

# Docker Compose overrides the hosts below with the service names (postgres, redis).
DATABASE_URL=postgresql://paybridge:paybridge@localhost:5432/paybridge
REDIS_URL=redis://localhost:6379

# inline = the outbox table is the queue (no Redis needed); bullmq = Redis-backed BullMQ workers.
QUEUE_DRIVER=bullmq
WORKER_INLINE=true

JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktY2hhbmdlLW1lLTMyLWJ5dGVzLWxvbmc=
FINGERPRINT_HMAC_KEY=dev-only-change-me-dev-only-change-me-dev-only
WEBHOOK_SIGNING_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# Where the mock provider sends its webhooks (the API itself).
WEBHOOK_TARGET_URL=http://localhost:4000

CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

FX_MID_RATE_AED_INR=22.70
FX_SPREAD_PCT=0.50
FX_FEE_AED=25.00
QUOTE_TTL_SECONDS=60
KYB_AUTO_APPROVE=false
MOCK_PROVIDER_DELAY_MS=3000
LOG_LEVEL=info

# Web
API_URL=http://localhost:4000
